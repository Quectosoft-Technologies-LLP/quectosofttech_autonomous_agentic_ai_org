# Quectosoft Technologies LLP — Autonomous Agentic AI Org
# Environment Configuration Template
# Author: Subrit Dikshit <subrit@quectosofttech.com>, <subrit@gmail.com>
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is in .gitignore.

# ── Model Providers (leave blank for Ollama-only offline mode) ──────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=

# ── Local Inference (Ollama) ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NANO=hermes3:1b            # HR ops, notifications, admin agents
MODEL_STANDARD=hermes3:8b        # Engineering, testing, standard SDLC agents
MODEL_ADVANCED=hermes3:70b       # Architects, legal, compliance, security agents
MODEL_CRITICAL=claude-opus-4     # Board, CEO/CTO/CFO/CLO, BFSI/Healthcare critical

# ── Memory Backends ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
POSTGRES_URL=postgresql://quecto:quecto@localhost:5432/quecto_ai
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_in_production

# ── MCP Servers ───────────────────────────────────────────────────────────
GITHUB_MCP_TOKEN=
JIRA_URL=
JIRA_API_TOKEN=
CONFLUENCE_URL=
CONFLUENCE_API_TOKEN=

# ── Communications (HITL notifications) ─────────────────────────────────
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=subrit@quectosofttech.com

# ── Platform Settings ─────────────────────────────────────────────────────
ENVIRONMENT=development           # development | staging | production
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-use-32-char-random-string
MAX_PARALLEL_AGENTS=10
DEFAULT_TOKEN_BUDGET=8192

# ── RAID Global Thresholds (per-agent overrides live in agent YAML cards) ─
RAID_AUTO_MITIGATE_BELOW=7
RAID_VP_REVIEW_FROM=7
RAID_CSUITE_GATE_FROM=13
RAID_HUMAN_HITL_FROM=20
