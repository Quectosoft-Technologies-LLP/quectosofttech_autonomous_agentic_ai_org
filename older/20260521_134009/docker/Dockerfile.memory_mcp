FROM python:3.12-slim
LABEL maintainer="subrit@quectosofttech.com"
RUN groupadd -r quecto && useradd -r -g quecto quecto
WORKDIR /app
COPY pyproject.toml .
RUN pip install --no-cache-dir fastapi uvicorn pydantic redis chromadb asyncpg
COPY mcp_servers/ ./mcp_servers/
USER quecto
ARG MCP_SERVER=agent_memory_mcp
ENV MCP_MODULE=mcp_servers.memory_mcp.${MCP_SERVER}.server
CMD uvicorn ${MCP_MODULE}:app --host 0.0.0.0 --port 9000
