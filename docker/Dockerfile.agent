FROM python:3.12-slim
LABEL maintainer="subrit@quectosofttech.com"
LABEL org.opencontainers.image.title="Quectosoft Agent"
LABEL org.opencontainers.image.version="0.3.2"

RUN groupadd -r quecto && useradd -r -g quecto quecto
WORKDIR /app

COPY pyproject.toml .
RUN pip install --no-cache-dir -e "." && pip install --no-cache-dir uvicorn

COPY src/ ./src/
COPY config/ ./config/

USER quecto
CMD ["uvicorn", "src.ui.backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
